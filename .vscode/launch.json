{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "ctrim_app (Chrome)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "deviceId": "chrome",
      "toolArgs": [
        "--web-hostname",
        "localhost",
        "--web-port",
        "7357"
      ],
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "ctrim_app (Web Server)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "deviceId": "web-server",
      "toolArgs": [
        "--web-hostname",
        "localhost",
        "--web-port",
        "7357"
      ],
      "cwd": "${workspaceFolder}"
    }
  ]
}

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // allow authenticated users to read all data
    match /{document=**} {
      allow read: if request.auth != null;
    }

    match /everyone/{auth_id}{
      allow write: if request.auth != null && 
      (
        ((exists(/databases/$(database)/documents/everyone/$(request.auth.uid)) && get(/databases/$(database)/documents/everyone/$(request.auth.uid)).data.isAdmin == true))
      );
      
      // allow authenticated users to create their own document 
      // TODO add the restriction on the fields. Only create if fields are [email]
      allow create: if request.auth != null && request.resource.data.id == request.auth;
    
      // for the bookmarks and supplemental parts, we should only allow the same user access to it
      match /supplemental/{document}{
        allow write: if request.auth != null && request.resource.data.auth == request.auth.uid;
      }
    }

    // TODO only 'isLeader' can create. 'isUser' (this includes leaders) can write
    match /events/{document}{
      allow write: if request.auth != null;
    }
    
    // TODO only 'isAdmin' can create. 'isUser' (this includes leaders) can write
    match /users/{document}{
      allow write: if request.auth != null;
    }

    // TODO only 'isLeader' can write (all admins should be a leader as well)
    match /id_tracker/{document}{
      allow write: if request.auth != null;
    }
  }
}
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/everyone/$(request.auth.uid)).data.isAdmin == true;
    }

    function isAreaAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/everyone/$(request.auth.uid)).data.isAreaAdmin == true;
    }

    function isWorker() {
      return request.auth != null &&
        get(/databases/$(database)/documents/everyone/$(request.auth.uid)).data.isUser == true;
    }

    function isLeader() {
      return request.auth != null &&
        get(/databases/$(database)/documents/everyone/$(request.auth.uid)).data.isLeader == true;
    }

    /// Creator of an unlinked placeholder may correct Forename/Surname only.
    /// Auth link + IsPlaceholder clear go through link_user_auth CF (Admin SDK).
    function isPlaceholderCreatorNameOnlyUpdate() {
      return request.auth != null
        && resource.data.get('IsPlaceholder', false) == true
        && resource.data.get('CreatedByUserID', '') != ''
        && get(/databases/$(database)/documents/users/$(resource.data.CreatedByUserID)).data.AuthID
             == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['Forename', 'Surname'])
        && request.resource.data.IsAreaAdmin == resource.data.IsAreaAdmin
        && request.resource.data.IsLeader == resource.data.IsLeader
        && request.resource.data.AuthID == resource.data.AuthID
        && request.resource.data.CreatedByUserID == resource.data.CreatedByUserID
        && request.resource.data.IsPlaceholder == true;
    }

    /// Head count fields only — used so any signed-in user can sync interest/attendee denorm.
    function isAttendanceCountOnlyUpdate() {
      return request.auth != null &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['InterestedCount', 'AttendeeCount']);
    }

    /// Self-serve interest: attendees unchanged; only the caller's interested map key may change.
    function onlyOwnInterestChanged() {
      return request.auth != null &&
        request.resource.data.get('attendees', []) == resource.data.get('attendees', []) &&
        request.resource.data.interested.diff(resource.data.get('interested', {}))
          .affectedKeys().hasOnly([request.auth.uid]);
    }

    function isOwnInterestCreate() {
      return request.auth != null &&
        request.resource.data.keys().hasOnly(['interested', 'attendees']) &&
        request.resource.data.attendees.size() == 0 &&
        request.resource.data.interested.keys().hasOnly([request.auth.uid]);
    }

    /// Caller is the volunteer whose `users/{userId}` profile is being written.
    function isOwnVolunteerProfile() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(userId)).data.AuthID
          == request.auth.uid;
    }

    // Default: deny all deletes, allow reads only with more specific rules below
    match /{document=**} {
      allow delete: if false;
    }

    match /everyone/{auth_id}{
      // Own doc, global admins, or area admins (e.g. view email when editing volunteers)
      allow read: if request.auth != null && (
        auth_id == request.auth.uid ||
        isAdmin() ||
        isAreaAdmin()
      );
      
      // allow authenticated users to create their own document 
      allow create: if request.auth != null && auth_id == request.auth.uid && request.resource.data.keys().hasOnly(['email']);
      
      // Global admins: full write. Area admins: volunteer flags only (no isAdmin escalation).
      allow update: if isAdmin() || (
        isAreaAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['isUser', 'isLeader', 'isAreaAdmin'])
      );
      
      // Supplemental: own user read/write; workers may read device_tokens to notify scheduled members
      match /supplemental/{document}{
        allow read: if request.auth != null && (
          auth_id == request.auth.uid ||
          isAdmin() ||
          (document == 'device_tokens' && isWorker())
        );
        allow write: if request.auth != null && request.resource.data.auth == request.auth.uid;
      }
    }

    // Events: split head vs supplemental so attendance names stay signed-in-only.
    match /events/{eventId} {
      allow read: if true;
      allow create: if isLeader();
      allow update: if isWorker() || isAttendanceCountOnlyUpdate();

      match /supplemental/{docId} {
        allow read: if docId == 'attendance'
          ? request.auth != null
          : true;

        allow create: if docId == 'attendance'
          ? (isWorker() || isOwnInterestCreate())
          : isWorker();

        allow update: if docId == 'attendance'
          ? (isWorker() || onlyOwnInterestChanged())
          : isWorker();
      }
    }
    
    match /users/{userId}{
      // Allow anyone to read user profiles (guest-friendly)
      allow read: if true;

      // Area admins register volunteers (matches Volunteers UI).
      // Placeholder minting for non-admins goes through create_placeholder_user CF.
      allow create: if isAreaAdmin() || isAdmin();

      // Area admins may edit any profile; volunteers may only change their own ImgSrc;
      // placeholder creators may edit name (+ clear IsPlaceholder only via link CF).
      allow update: if isAreaAdmin() || isAdmin() || (
        isWorker() &&
        resource.data.AuthID == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ImgSrc'])
      ) || isPlaceholderCreatorNameOnlyUpdate();

      // Role/post tracking updated by workers when managing events.
      // Activity is guest-readable; workers may only append their own log
      // (area/global admins seed empty activity when registering people).
      match /supplemental/{document}{
        allow read: if true;
        allow write: if document == 'activity'
          ? (isAdmin() || isAreaAdmin() || isOwnVolunteerProfile())
          : (isAdmin() || isAreaAdmin() || isWorker());
      }
    }

    match /user_tags/{tagId} {
      allow read: if true;
      allow create, update, delete: if isAreaAdmin() || isAdmin();
    }

    match /user_locations/{locationId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null &&
        (isAreaAdmin() || isAdmin());
    }

    match /post_tags/{tagId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null &&
        (isAreaAdmin() || isAdmin());
    }

    // Cell groups: guest-safe head readable by all; roster is signed-in only.
    // LeaderAuthIds denorm lets leaders edit roster without reverse user lookup.
    function isCellGroupLeaderFromParent() {
      return request.auth != null &&
        get(/databases/$(database)/documents/cell_groups/$(cellGroupId))
          .data.get('LeaderAuthIds', []).hasAny([request.auth.uid]);
    }

    match /cell_groups/{cellGroupId} {
      allow read: if true;
      allow create: if isAreaAdmin() || isAdmin();
      allow update: if isAreaAdmin() || isAdmin();
      allow delete: if isAreaAdmin() || isAdmin();

      match /supplemental/{docId} {
        allow read: if request.auth != null;
        allow create, update: if isAreaAdmin() || isAdmin() || isCellGroupLeaderFromParent();
      }
    }

    /// Signed-in users may bump collection watermarks (profile photo, interest
    /// counts) without touching ID counters.
    function isLastUpdateOnlyTrackerUpdate() {
      return request.auth != null &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['lastUpdate']);
    }

    match /id_tracker/{docId}{
      // Allow anyone to read tracker (needed for guest user/event caching)
      allow read: if true;
      
      allow create: if false;

      // users counter: area admins register volunteers; events: leaders;
      // cell_groups: area admins create catalogue records.
      // lastUpdate-only: any signed-in user (self-serve photo / attendance denorm).
      allow update: if isLastUpdateOnlyTrackerUpdate() || (
        docId == 'users'
          ? (isAreaAdmin() || isLeader() || isAdmin())
          : docId == 'cell_groups'
            ? (isAreaAdmin() || isAdmin())
            : (isLeader() || isAdmin())
      );
    }

    match /post_templates/{documents=**}{
      // Allow anyone to read post templates (guest-friendly)
      allow read: if true;

      // Leaders can create and edit post templates (manage UI is gated on isLeader)
      allow create, write: if isLeader();
    }

    match /information/{sectionId} {
      allow read: if true;
      // Area admins and leaders (UI gated via User.canManageInfo)
      allow create, write: if request.auth != null &&
        (isLeader() ||
         isAreaAdmin() ||
         isAdmin() ||
         request.auth.token.isLeader == true ||
         request.auth.token.isAreaAdmin == true ||
         request.auth.token.isAdmin == true);

      match /items/{documentId} {
        allow read: if true;
        allow create, write: if request.auth != null &&
          (isLeader() ||
           isAreaAdmin() ||
           isAdmin() ||
           request.auth.token.isLeader == true ||
           request.auth.token.isAreaAdmin == true ||
           request.auth.token.isAdmin == true);

        // Nested church hub pages. Create/update: area admin / admin.
        // Delete also allows Leaders so church-record cascade can clear pages.
        match /pages/{pageId} {
          allow read: if true;
          allow create, update: if request.auth != null &&
            (isAreaAdmin() ||
             isAdmin() ||
             request.auth.token.isAreaAdmin == true ||
             request.auth.token.isAdmin == true);
          allow delete: if request.auth != null &&
            (isLeader() ||
             isAreaAdmin() ||
             isAdmin() ||
             request.auth.token.isLeader == true ||
             request.auth.token.isAreaAdmin == true ||
             request.auth.token.isAdmin == true);
        }
      }
    }

    // Allow authenticated users to manage web push tokens and topic subscriptions
    match /notification_tokens/{docId} {
      allow read: if request.auth != null && (
        request.auth.token.isLeader == true ||
        request.auth.token.isAreaAdmin == true ||
        isWorker() ||
        isAdmin()
      );
      allow write: if request.auth != null && docId in ['web_tokens', 'web_topics'];
    }
  }
}

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/everyone/$(request.auth.uid)).data.isAdmin == true;
    }

    function isAreaAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/everyone/$(request.auth.uid)).data.isAreaAdmin == true;
    }

    function isWorker() {
      return request.auth != null &&
        get(/databases/$(database)/documents/everyone/$(request.auth.uid)).data.isUser == true;
    }

    function isLeader() {
      return request.auth != null &&
        get(/databases/$(database)/documents/everyone/$(request.auth.uid)).data.isLeader == true;
    }

    /// Head count fields only — used so any signed-in user can sync interest/attendee denorm.
    function isAttendanceCountOnlyUpdate() {
      return request.auth != null &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['InterestedCount', 'AttendeeCount']);
    }

    /// Self-serve interest: attendees unchanged; only the caller's interested map key may change.
    function onlyOwnInterestChanged() {
      return request.auth != null &&
        request.resource.data.get('attendees', []) == resource.data.get('attendees', []) &&
        request.resource.data.interested.diff(resource.data.get('interested', {}))
          .affectedKeys().hasOnly([request.auth.uid]);
    }

    function isOwnInterestCreate() {
      return request.auth != null &&
        request.resource.data.keys().hasOnly(['interested', 'attendees']) &&
        request.resource.data.attendees.size() == 0 &&
        request.resource.data.interested.keys().hasOnly([request.auth.uid]);
    }

    // Default: deny all deletes, allow reads only with more specific rules below
    match /{document=**} {
      allow delete: if false;
    }

    match /everyone/{auth_id}{
      // Own doc, global admins, or area admins (e.g. view email when editing volunteers)
      allow read: if request.auth != null && (
        auth_id == request.auth.uid ||
        isAdmin() ||
        isAreaAdmin()
      );
      
      // allow authenticated users to create their own document 
      allow create: if request.auth != null && auth_id == request.auth.uid && request.resource.data.keys().hasOnly(['email']);
      
      // only allow admin to write to these (for registering users)
      allow write: if request.auth != null && get(/databases/$(database)/documents/everyone/$(request.auth.uid)).data.isAdmin == true;    
      
      // Supplemental: own user read/write; workers may read device_tokens to notify scheduled members
      match /supplemental/{document}{
        allow read: if request.auth != null && (
          auth_id == request.auth.uid ||
          isAdmin() ||
          (document == 'device_tokens' && isWorker())
        );
        allow write: if request.auth != null && request.resource.data.auth == request.auth.uid;
      }
    }

    // Events: split head vs supplemental so attendance names stay signed-in-only.
    match /events/{eventId} {
      allow read: if true;
      allow create: if isLeader();
      allow update: if isWorker() || isAttendanceCountOnlyUpdate();

      match /supplemental/{docId} {
        allow read: if docId == 'attendance'
          ? request.auth != null
          : true;

        allow create: if docId == 'attendance'
          ? (isWorker() || isOwnInterestCreate())
          : isWorker();

        allow update: if docId == 'attendance'
          ? (isWorker() || onlyOwnInterestChanged())
          : isWorker();
      }
    }
    
    match /users/{userId}{
      // Allow anyone to read user profiles (guest-friendly)
      allow read: if true;

      // Only admins can register new users
      allow create: if request.auth != null && get(/databases/$(database)/documents/everyone/$(request.auth.uid)).data.isAdmin == true;

      // Admins may edit any profile; volunteers may only change their own ImgSrc
      allow update: if request.auth != null && (
        get(/databases/$(database)/documents/everyone/$(request.auth.uid)).data.isAdmin == true ||
        (
          get(/databases/$(database)/documents/everyone/$(request.auth.uid)).data.isUser == true &&
          resource.data.AuthID == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ImgSrc'])
        )
      );

      // Role/post tracking updated by workers when managing events
      match /supplemental/{document}{
        allow read: if true;
        allow write: if request.auth != null && (
          get(/databases/$(database)/documents/everyone/$(request.auth.uid)).data.isAdmin == true ||
          get(/databases/$(database)/documents/everyone/$(request.auth.uid)).data.isUser == true
        );
      }
    }

    match /user_tags/{tagId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null &&
        get(/databases/$(database)/documents/everyone/$(request.auth.uid)).data.isAdmin == true;
    }

    match /user_locations/{locationId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null &&
        (isAreaAdmin() || isAdmin());
    }

    match /post_tags/{tagId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null &&
        (isAreaAdmin() || isAdmin());
    }

    match /id_tracker/{documents=**}{
      // Allow anyone to read tracker (needed for guest user caching)
      allow read: if true;
      
      allow create: if false;

      // allows leaders to create new posts and admins to register new users
      allow write: if request.auth != null && get(/databases/$(database)/documents/everyone/$(request.auth.uid)).data.isLeader == true; 
    }

    match /post_templates/{documents=**}{
      // Allow anyone to read post templates (guest-friendly)
      allow read: if true;

      // Leaders can create and edit post templates (manage UI is gated on isLeader)
      allow create, write: if isLeader();
    }

    match /information/{sectionId} {
      allow read: if true;
      allow create, write: if request.auth != null &&
        (request.auth.token.isAreaAdmin == true ||
         request.auth.token.isAdmin == true ||
         get(/databases/$(database)/documents/everyone/$(request.auth.uid)).data.isAreaAdmin == true ||
         get(/databases/$(database)/documents/everyone/$(request.auth.uid)).data.isAdmin == true);

      match /items/{documentId} {
        allow read: if true;
        allow create, write: if request.auth != null &&
          (request.auth.token.isAreaAdmin == true ||
           request.auth.token.isAdmin == true ||
           get(/databases/$(database)/documents/everyone/$(request.auth.uid)).data.isAreaAdmin == true ||
           get(/databases/$(database)/documents/everyone/$(request.auth.uid)).data.isAdmin == true);
      }
    }

    // Allow authenticated users to manage web push tokens and topic subscriptions
    match /notification_tokens/{docId} {
      allow read: if request.auth != null && (
        request.auth.token.isLeader == true ||
        request.auth.token.isAreaAdmin == true ||
        isWorker() ||
        isAdmin()
      );
      allow write: if request.auth != null && docId in ['web_tokens', 'web_topics'];
    }
  }
}

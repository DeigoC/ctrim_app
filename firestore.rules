rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/everyone/$(request.auth.uid)).data.isAdmin == true;
    }

    function isWorker() {
      return request.auth != null &&
        get(/databases/$(database)/documents/everyone/$(request.auth.uid)).data.isUser == true;
    }

    // Default: deny all deletes, allow reads only with more specific rules below
    match /{document=**} {
      allow delete: if false;
    }

    match /everyone/{auth_id}{
      // Only authenticated users can read their own auth document, or admins can read any
      allow read: if request.auth != null && (
        auth_id == request.auth.uid ||
        isAdmin()
      );
      
      // allow authenticated users to create their own document 
      allow create: if request.auth != null && auth_id == request.auth.uid && request.resource.data.keys().hasOnly(['email']);
      
      // only allow admin to write to these (for registering users)
      allow write: if request.auth != null && get(/databases/$(database)/documents/everyone/$(request.auth.uid)).data.isAdmin == true;    
      
      // Supplemental: own user read/write; workers may read device_tokens to notify scheduled members
      match /supplemental/{document}{
        allow read: if request.auth != null && (
          auth_id == request.auth.uid ||
          isAdmin() ||
          (document == 'device_tokens' && isWorker())
        );
        allow write: if request.auth != null && request.resource.data.auth == request.auth.uid;
      }
    }

    match /events/{documents=**}{
      // Allow anyone to read events (guest-friendly)
      allow read: if true;
      
      // only leaders (and ergo admins) can create new posts
      allow create: if request.auth != null && get(/databases/$(database)/documents/everyone/$(request.auth.uid)).data.isLeader == true;  
      
      // allow workers to edit these posts (this covers leaders and admins)
      allow write: if request.auth != null && get(/databases/$(database)/documents/everyone/$(request.auth.uid)).data.isUser == true;   
    }
    
    match /users/{userId}{
      // Allow anyone to read user profiles (guest-friendly)
      allow read: if true;

      // Only admins can register new users
      allow create: if request.auth != null && get(/databases/$(database)/documents/everyone/$(request.auth.uid)).data.isAdmin == true;

      // Admins may edit any profile; other users may only edit their own
      allow update: if request.auth != null && (
        get(/databases/$(database)/documents/everyone/$(request.auth.uid)).data.isAdmin == true ||
        (
          get(/databases/$(database)/documents/everyone/$(request.auth.uid)).data.isUser == true &&
          resource.data.AuthID == request.auth.uid
        )
      );

      // Role/post tracking updated by workers when managing events
      match /supplemental/{document}{
        allow read: if true;
        allow write: if request.auth != null && (
          get(/databases/$(database)/documents/everyone/$(request.auth.uid)).data.isAdmin == true ||
          get(/databases/$(database)/documents/everyone/$(request.auth.uid)).data.isUser == true
        );
      }
    }

    match /user_tags/{tagId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null &&
        get(/databases/$(database)/documents/everyone/$(request.auth.uid)).data.isAdmin == true;
    }

    match /id_tracker/{documents=**}{
      // Allow anyone to read tracker (needed for guest user caching)
      allow read: if true;
      
      allow create: if false;

      // allows leaders to create new posts and admins to register new users
      allow write: if request.auth != null && get(/databases/$(database)/documents/everyone/$(request.auth.uid)).data.isLeader == true; 
    }

    match /post_templates/{documents=**}{
      // Allow anyone to read post templates (guest-friendly)
      allow read: if true;
      
      // only leaders can create and edit post templates
      allow create, write: if request.auth != null && get(/databases/$(database)/documents/everyone/$(request.auth.uid)).data.isLeader == true;
    }

    match /information/{sectionId} {
      allow read: if true;
      allow create, write: if request.auth != null &&
        (request.auth.token.isAreaAdmin == true ||
         request.auth.token.isAdmin == true ||
         get(/databases/$(database)/documents/everyone/$(request.auth.uid)).data.isAreaAdmin == true ||
         get(/databases/$(database)/documents/everyone/$(request.auth.uid)).data.isAdmin == true);

      match /items/{documentId} {
        allow read: if true;
        allow create, write: if request.auth != null &&
          (request.auth.token.isAreaAdmin == true ||
           request.auth.token.isAdmin == true ||
           get(/databases/$(database)/documents/everyone/$(request.auth.uid)).data.isAreaAdmin == true ||
           get(/databases/$(database)/documents/everyone/$(request.auth.uid)).data.isAdmin == true);
      }
    }

    // Allow authenticated users to manage web push tokens and topic subscriptions
    match /notification_tokens/{docId} {
      allow read: if request.auth != null && (
        request.auth.token.isLeader == true ||
        request.auth.token.isAreaAdmin == true ||
        isWorker() ||
        isAdmin()
      );
      allow write: if request.auth != null && docId in ['web_tokens', 'web_topics'];
    }
  }
}